rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function validStudent(d) {
      return d.keys().hasOnly(['name', 'photo', 'accountType', 'visible', 'updatedAt',
          'focusMinutes', 'quizAttempts', 'quizWins', 'quizCorrect', 'quizQuestions', 'lastEventId'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 40
        && d.photo is string && d.photo.size() <= 12000
        && d.accountType in ['local', 'google'] && d.visible is bool
        && d.updatedAt == request.time && d.lastEventId is string
        && d.focusMinutes is int && d.focusMinutes >= 0
        && d.quizAttempts is int && d.quizAttempts >= 0
        && d.quizWins is int && d.quizWins >= 0 && d.quizWins <= d.quizAttempts
        && d.quizQuestions is int && d.quizQuestions >= 0
        && d.quizCorrect is int && d.quizCorrect >= 0 && d.quizCorrect <= d.quizQuestions;
    }
    function validEvent(d) {
      return d.keys().hasOnly(['focusMinutes', 'quizAttempts', 'quizWins', 'quizCorrect', 'quizQuestions', 'createdAt'])
        && d.createdAt == request.time
        && d.focusMinutes is int && d.quizAttempts is int && d.quizWins is int
        && d.quizCorrect is int && d.quizQuestions is int
        && ((d.focusMinutes >= 1 && d.focusMinutes <= 480 && d.quizAttempts == 0
          && d.quizWins == 0 && d.quizCorrect == 0 && d.quizQuestions == 0)
        || (d.focusMinutes == 0 && d.quizAttempts == 1 && d.quizQuestions >= 1 && d.quizQuestions <= 500
          && d.quizCorrect >= 0 && d.quizCorrect <= d.quizQuestions
          && d.quizWins == (d.quizCorrect * 100 >= d.quizQuestions * 80 ? 1 : 0)));
    }
    function addsEvent(before, after, event) {
      return after.visible == true
        && after.focusMinutes == before.focusMinutes + event.focusMinutes
        && after.quizAttempts == before.quizAttempts + event.quizAttempts
        && after.quizWins == before.quizWins + event.quizWins
        && after.quizCorrect == before.quizCorrect + event.quizCorrect
        && after.quizQuestions == before.quizQuestions + event.quizQuestions;
    }
    match /leaderboardStudents/{uid} {
      allow get: if signedIn() && (owner(uid) || resource.data.visible == true);
      allow list: if signedIn() && resource.data.visible == true && request.query.limit <= 100;
      allow create: if owner(uid) && validStudent(request.resource.data)
        && request.resource.data.focusMinutes == 0 && request.resource.data.quizAttempts == 0
        && request.resource.data.quizWins == 0 && request.resource.data.quizCorrect == 0
        && request.resource.data.quizQuestions == 0 && request.resource.data.lastEventId == '';
      function unchangedScores() {
        return !request.resource.data.diff(resource.data).affectedKeys().hasAny(
          ['focusMinutes', 'quizAttempts', 'quizWins', 'quizCorrect', 'quizQuestions', 'lastEventId']);
      }
      function newEvent() {
        let id = request.resource.data.lastEventId;
        let path = /databases/$(database)/documents/leaderboardStudents/$(uid)/events/$(id);
        return id != '' && !exists(path) && validEvent(getAfter(path).data)
          && addsEvent(resource.data, request.resource.data, getAfter(path).data);
      }
      allow update: if owner(uid) && validStudent(request.resource.data) && (unchangedScores() || newEvent());
      allow delete: if false;
      match /events/{id} {
        allow get: if owner(uid);
        allow list: if false;
        allow create: if owner(uid) && validEvent(request.resource.data)
          && id.matches('focus_[a-f0-9-]{36}|quiz_[0-9]{4}-[0-9]{2}-[0-9]{2}_[a-f0-9]{64}')
          && getAfter(/databases/$(database)/documents/leaderboardStudents/$(uid)).data.lastEventId == id
          && addsEvent(get(/databases/$(database)/documents/leaderboardStudents/$(uid)).data,
            getAfter(/databases/$(database)/documents/leaderboardStudents/$(uid)).data, request.resource.data);
        allow update, delete: if false;
      }
    }
    // No email, private notes, PDFs or question content is stored in these collections.
    match /{document=**} { allow read, write: if false; }
  }
}
